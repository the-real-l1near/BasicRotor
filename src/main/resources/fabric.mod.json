{
  "schemaVersion": 1,
  "icon": "assets/basicrotor/icon.png",
  "id": "basicrotor",
  "version": "${version}",
  "name": "BasicRotor",
  "description": "§6Simple rotating structures powered by redstone.\n§7Link blocks, power the Rotor, and watch them move.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.l1near.basicrotor.BasicRotor"
    ],
    "client": [
      "com.l1near.basicrotor.client.BasicRotorClient"
    ]
  },
  "mixins": [
    {
      "config": "basicrotor.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}